{
  "name": "the-swarm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "THE SWARM — Incremental game from ant queen to interstellar conquest",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "tsc --noEmit && vitest run && playwright test",
    "lint": "oxlint",
    "prepare": "sh scripts/setup-hooks.sh",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.5"
  },
  "packageManager": "pnpm@11.5.0"
}
