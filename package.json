{
  "name": "the-swarm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "THE SWARM — Incremental game from ant queen to interstellar conquest",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "tsc --noEmit && vitest run && playwright test",
    "lint": "oxlint",
    "perf": "vitest run --config vitest.perf.config.ts",
    "prepare": "sh scripts/setup-hooks.sh",
    "typecheck": "tsc --noEmit",
    "sim": "node scripts/sim.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "fast-check": "^4.11.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "@preact/signals-core": "^1.14.5",
    "preact": "^11.2.0"
  },
  "packageManager": "pnpm@11.5.0"
}
